# 服务端配置。绝不能给密钥变量加 VITE_ 前缀。
ELM_BASE_URL=https://elm.edina.ac.uk/api/v1
ELM_MODEL=学校账户实际可用的模型名称
ELM_API_STYLE=chat
# 选择一种凭据来源（不要同时复制现有密钥）：
# ELM_CREDENTIAL_CONFIG=/absolute/path/to/proxy-config.yaml
# ELM_CONFIG_PYTHON_BIN=/path/to/python-with-pyyaml
# 或本人在本机填写：
# ELM_API_KEY=
# STUDY_PYTHON_BIN=/path/to/python-with-pypdf

# 仅在学校接口已验证支持的 Qwen 模型使用此开关：
# ELM_ENABLE_THINKING=false
# STUDY_ANSWER_MAX_TOKENS=2200
# STUDY_PLAN_MAX_TOKENS=7000
# 在学校接口已验证支持时开启 JSON 模式：
# ELM_JSON_MODE=json_object
# STUDY_ANSWER_TIMEOUT_MS=60000
# STUDY_PLAN_TIMEOUT_MS=120000
